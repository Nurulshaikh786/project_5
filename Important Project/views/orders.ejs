<!DOCTYPE HTML>
<html>
    <%- include('common_head'); -%>
<body class="cbp-spmenu-push">
	<div class="main-content">
	<div class="cbp-spmenu cbp-spmenu-vertical cbp-spmenu-left" id="cbp-spmenu-s1">
		<!--left-fixed -navigation-->
		<%- include('common_sidebar'); -%>
	</div>
		<!--left-fixed -navigation-->
		
		<!-- header-starts -->
        <%- include('common_header'); -%>
		<!-- //header-ends -->
		<!-- main content start-->
		<div id="page-wrapper">
			<div class="main-page">
				<div class="tables">
					<div class="table-responsive bs-example widget-shadow">
						<h4>Order List</h4>						
						<table class="table table-bordered"> 
							<thead> 
								<tr> 
									<th>#</th> 
									<th>Supplier</th> 
									<th>Order Num</th>
									<th>Product Name</th>
									<th>Qty</th>
									<th>Size</th>
									<th>Price</th>
									<th>Status</th>
								</tr> 
							</thead> 
							<tbody> 
								<% for(var i=0; i < order_list.length; i++) { %>
								<tr> 
									<th scope="row"><%= i+1 %></th> 
									<td><%= order_list[i].supplier_name %></td> 
									<td><%= order_list[i].order_num %></td> 
									<td><%= order_list[i].sub_orders[0].product_details.name %></td> 	
									<td><%= order_list[i].sub_orders[0].product_details.quantity %></td> 	
									<td><%= order_list[i].sub_orders[0].product_details.size %></td> 		
									<td><%= order_list[i].sub_orders[0].product_details.price %></td> 	
									<td><% if(order_list[i].sub_orders[0].status_details.message.display_string.includes("time")) {  
										var mydate = new Date(order_list[i].sub_orders[0].status_details.message.iso_timestamp);
										var str = mydate.toString(order_list[i].sub_orders[0].status_details.message.output_format); %>
										<%= order_list[i].sub_orders[0].status_details.message.display_string.replace("<time>", '') + str.replace("GMT+0530 (India Standard Time)","") %>
										<% }else{ %>
										<%= order_list[i].sub_orders[0].status_details.message.display_string  %>
										<% } %>
									</td> 		
																	
								<tr> 
								<% } %>

							</tbody> 
						</table> 
					</div>
				</div>
				
			</div>
		</div>
		<!--footer-->
        <%- include('common_footer'); -%>
        <!--//footer-->
	</div>
	
	<!-- side nav js -->
	<script src='js/SidebarNav.min.js' type='text/javascript'></script>
	<script>
      $('.sidebar-menu').SidebarNav()
    </script>
	<!-- //side nav js -->
	
	<!-- Classie --><!-- for toggle left push menu script -->
		<script src="js/classie.js"></script>
		<script>
			var menuLeft = document.getElementById( 'cbp-spmenu-s1' ),
				showLeftPush = document.getElementById( 'showLeftPush' ),
				body = document.body;
				
			showLeftPush.onclick = function() {
				classie.toggle( this, 'active' );
				classie.toggle( body, 'cbp-spmenu-push-toright' );
				classie.toggle( menuLeft, 'cbp-spmenu-open' );
				disableOther( 'showLeftPush' );
			};
			
			function disableOther( button ) {
				if( button !== 'showLeftPush' ) {
					classie.toggle( showLeftPush, 'disabled' );
				}
			}

			$("#mobile").on('paste input', function(){
      			var mobile  = document.getElementById( 'mobile' ).value;				
				if(mobile.length == 10){
					console.log(mobile.length+" >>> "+mobile);	
				}
			});

		</script>
	<!-- //Classie --><!-- //for toggle left push menu script -->
	
	<!--scrolling js-->
	<script src="js/jquery.nicescroll.js"></script>
	<script src="js/scripts.js"></script>
	<!--//scrolling js-->
	
	<!-- Bootstrap Core JavaScript -->
   <script src="js/bootstrap.js"> </script>
   
</body>
</html>