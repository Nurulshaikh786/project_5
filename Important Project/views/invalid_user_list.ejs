<!DOCTYPE HTML>
<html>
<%- include('common_head'); -%>

    <body class="cbp-spmenu-push">
        <div class="main-content">
            <div class="cbp-spmenu cbp-spmenu-vertical cbp-spmenu-left" id="cbp-spmenu-s1">
                <!--left-fixed -navigation-->
                <%- include('common_sidebar'); -%>
            </div>
            <!--left-fixed -navigation-->

            <!-- header-starts -->
            <%- include('common_header'); -%>
                <!-- //header-ends -->
                <!-- main content start-->
                <div id="page-wrapper">
                    <div class="main-page">

                        <div class="button_set_one two agile_info_shadow">
                            <!-- Standard button -->
                            <h3 class="w3_inner_tittle two"> Action</h3>

                            <button type="button" class="btn btn-default" data-toggle="modal" data-target="#exampleModal" data-placement="bottom" title="">Create Account</button>
                            <!--<a class="btn btn-info" href="renew_xo">Token Refresh</a>-->
                            <!--<a class="btn btn-info" href="create_order">Create Order</a>-->

                            <form action="/submit_otp" method="POST">
                                <div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                <h4 class="modal-title" id="exampleModalLabel">Create Account</h4>
                                            </div>
                                            <div class="modal-body">
                                                <div class="form-group">
                                                    <label for="recipient-name" class="control-label">Mobile Number</label>
                                                    <input type="text" pattern="\d*" maxlength="10" class="form-control" name="mobile" autocomplete="off" id="mobile">
                                                </div>
                                                <div class="form-group">
                                                    <label for="message-text" class="control-label">OTP</label>
                                                    <input type="text" class="form-control" name="otp" autocomplete="off" id="otp">
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                                <button type="submit" class="btn btn-primary">Submit</button>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </form>

                        </div>

                        <div class="tables">
                            <div class="table-responsive bs-example widget-shadow">
                                <h4>Ready Users (
                                    <%= total %> )</h4>
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Mobile</th>
                                            <th>My ReferCode</th>
                                            <th>ReferCode</th>
                                            <th>User Status</th>
                                            <th>Bank Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for(var i=0; i < data.length; i++) { %>
                                            <tr>
                                                <th scope="row">
                                                    <%= data[i].id %>
                                                </th>
                                                <td>
                                                    <%= data[i].mobile %>
                                                </td>
                                                <td>
                                                    <%= data[i].my_refer_code %>
                                                </td>
                                                <td>
                                                    <%= data[i].reffer_code %>
                                                </td>
                                                <% if(data[i].otp_verify==1) { %>
                                                    <td>Verify</td>
                                                    <% }else { %>
                                                        <td>Not Verify</td>
                                                        <% } %>

                                                            <% if(data[i].bank_status!=0) { %>
                                                                <td>
                                                                    <%= data[i].bank_status %>
                                                                </td>
                                                                <% }else { %>
                                                                    <td></td>
                                                                    <% } %>


                                                                        <td>
                                                                            <% if(data[i].otp_verify==0) { %>
                                                                                <a class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete account?')" href="delete_account?user_id=<%= data[i].id %>">Delete</a>
                                                                                <a class="btn btn-sm btn-primary" href="add_refaral?user_id=<%= data[i].user_id %>">Add Reffer</a>                                                                              
                                                                                <% } else { %>

                                                                                    <a class="btn btn-sm btn-primary" href="renew_user_xo?user_id=<%= data[i].user_id %>">Refresh Token</a>
                                                                                    <a class="btn btn-sm btn-primary" href="order?user_id=<%= data[i].user_id %>">Orders</a>
                                                                                    <a class="btn btn-sm btn-primary" onclick="return confirm('Are you sure you want to place order?')" href="create_user_order?user_id=<%= data[i].user_id %>">Create Order</a>

                                                                                    <% if(data[i].bank_status!="SUCCESS") { %>
                                                                                        <button type="button" class="btn btn-sm btn-primaryy" data-toggle="modal" data-target="#bankAdd<%= data[i].user_id %>" data-placement="bottom" title="">Add Bank Account</button>
                                                                                        <form action="/add_bank_account" method="POST">
                                                                                            <div class="modal fade" id="bankAdd<%= data[i].user_id %>" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel">
                                                                                                <div class="modal-dialog" role="document">
                                                                                                    <div class="modal-content">
                                                                                                        <div class="modal-header">
                                                                                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                                                                                                            <h4 class="modal-title">Add Bank Account (
                                                                                                                <%=data[i].mobile %> )
                                                                                                            </h4>
                                                                                                        </div>
                                                                                                        <div class="modal-body">
                                                                                                            <div class="form-group">
                                                                                                                <label for="recipient-name" class="control-label">Beneficiary Name</label>
                                                                                                                <input type="text" class="form-control" name="account_name" autocomplete="off">
                                                                                                            </div>
                                                                                                            <div class="form-group">
                                                                                                                <label for="recipient-name" class="control-label">Account Number</label>
                                                                                                                <input type="text" class="form-control" name="account_number" autocomplete="off">
                                                                                                            </div>
                                                                                                            <div class="form-group">
                                                                                                                <label for="recipient-name" class="control-label">IFSC Code</label>
                                                                                                                <input type="text" class="form-control" name="ifsc" autocomplete="off">
                                                                                                                <input type="hidden" class="form-control" name="user_id" value="<%= data[i].user_id %>" autocomplete="off">
                                                                                                            </div>
                                                                                                        </div>
                                                                                                        <div class="modal-footer">
                                                                                                            <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                                                                                                            <button type="submit" class="btn btn-primary">Submit</button>
                                                                                                        </div>

                                                                                                    </div>
                                                                                                </div>
                                                                                            </div>
                                                                                        </form>
                                                                                        <% } %>
                                                                                            <% } %>
                                                                        </td>
                                                                        <tr>
                                                                            <% } %>

                                    </tbody>
                                </table>

                                <% if (pages > 0) { %>
                                    <ul class="pagination text-center">
                                        <% if (current == 1) { %>
                                            <li class="disabled"><a>First</a></li>
                                            <% } else { %>
                                                <li><a href="/invalid_user?page=1">First</a></li>
                                                <% } %>
                                                    <% var i = (Number(current) > 5 ? Number(current) - 4 : 1) %>
                                                        <% if (i !== 1) { %>
                                                            <li class="disabled"><a>...</a></li>
                                                            <% } %>
                                                                <% for (; i <= (Number(current) + 4) && i <= pages; i++) { %>
                                                                    <% if (i == current) { %>
                                                                        <li class="active">
                                                                            <a>
                                                                                <%= i %>
                                                                            </a>
                                                                        </li>
                                                                        <% } else { %>
                                                                            <li>
                                                                                <a href="/invalid_user?page=<%= i %>">
                                                                                    <%= i %>
                                                                                </a>
                                                                            </li>
                                                                            <% } %>
                                                                                <% if (i == Number(current) + 4 && i < pages) { %>
                                                                                    <li class="disabled"><a>...</a></li>
                                                                                    <% } %>
                                                                                        <% } %>
                                                                                            <% if (current == pages) { %>
                                                                                                <li class="disabled"><a>Last</a></li>
                                                                                                <% } else { %>
                                                                                                    <li><a href="/invalid_user?page=<%= pages %>">Last</a></li>
                                                                                                    <% } %>
                                    </ul>
                                    <% } %>

                            </div>
                        </div>

                    </div>
                </div>
                <!--footer-->
                <%- include('common_footer'); -%>
                    <!--//footer-->
        </div>

        <!-- side nav js -->
        <script src='js/SidebarNav.min.js' type='text/javascript'></script>
        <script>
            $('.sidebar-menu').SidebarNav()
        </script>
        <!-- //side nav js -->

        <!-- Classie -->
        <!-- for toggle left push menu script -->
        <script src="js/classie.js"></script>
        <script>
            var menuLeft = document.getElementById('cbp-spmenu-s1'),
                showLeftPush = document.getElementById('showLeftPush'),
                body = document.body;

            showLeftPush.onclick = function() {
                classie.toggle(this, 'active');
                classie.toggle(body, 'cbp-spmenu-push-toright');
                classie.toggle(menuLeft, 'cbp-spmenu-open');
                disableOther('showLeftPush');
            };

            function disableOther(button) {
                if (button !== 'showLeftPush') {
                    classie.toggle(showLeftPush, 'disabled');
                }
            }

            $("#mobile").on('paste input', function() {
                var mobile = document.getElementById('mobile').value;
                if (mobile.length == 10) {
                    console.log(mobile.length + " >>> " + mobile);
                    $.ajax({
                        type: 'GET',
                        dataType: "json",
                        url: 'users/request_otp?mobile=' + mobile,
                        success: function(data, status, xhr) {
                            console.log('data: ', data);
                            if (data.status == "Success") {
                                window.location.replace("user");
                            }
                        },
                        error: function(xhr, textStatus, errorThrown) {
                            console.log('Error in Operation');
                        }
                    });
                }
            });
        </script>
        <!-- //Classie -->
        <!-- //for toggle left push menu script -->

        <!--scrolling js-->
        <script src="js/jquery.nicescroll.js"></script>
        <script src="js/scripts.js"></script>
        <!--//scrolling js-->

        <!-- Bootstrap Core JavaScript -->
        <script src="js/bootstrap.js">
        </script>

    </body>

</html>